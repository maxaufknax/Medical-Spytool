# Database Configuration
# Für lokale Entwicklung (z.B.: postgresql://username:password@localhost:5432/medicalspy)
# WICHTIG: Ersetzen Sie username und password mit Ihren PostgreSQL-Zugangsdaten
DATABASE_URL=postgresql://username:password@localhost:5432/medicalspy

# Session Secret - Ändern Sie dies zu einem zufälligen String in der Produktion!
# Sie können einen sicheren Schlüssel mit Python generieren: 
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_secure_session_key_here

# API-Schlüssel für wissenschaftliche Datenbanken
# PubMed: Beantragen Sie einen API-Schlüssel bei https://www.ncbi.nlm.nih.gov/home/develop/api/
PUBMED_API_KEY=

# Scopus: Optional, beantragen bei https://dev.elsevier.com/
SCOPUS_API_KEY=

# Web of Science: Optional, beantragen bei https://clarivate.com/
WOS_API_KEY=

# Logging-Konfiguration
# Verfügbare Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Anwendungseinstellungen
# Ausgabeverzeichnis für gespeicherte Dateien
OUTPUT_PATH=./output

# Verzeichnis für Personenlisten
PERSON_LIST_PATH=./person_lists

# Standard-Datenbank für Suchen (PubMed, DNB, Scopus, WoS)
DEFAULT_DATABASE=PubMed

# Entwicklungseinstellungen
# Auf True setzen, um Debug-Modus zu aktivieren (nur für Entwicklung!)
FLASK_DEBUG=False