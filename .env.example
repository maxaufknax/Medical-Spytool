# ========================================================================
# MedicalSpy - Umgebungsvariablen Konfiguration
# ========================================================================
# Kopieren Sie diese Datei zu .env und passen Sie die Werte an
# ========================================================================

# ------------------------------------------
# Datenbank Konfiguration
# ------------------------------------------

# SQLite (Standard, einfach für lokale Entwicklung)
DATABASE_URL=sqlite:///instance/medicalspy.db

# PostgreSQL (empfohlen für Produktion)
# DATABASE_URL=postgresql://username:password@localhost:5432/medicalspy

# ------------------------------------------
# Anwendungskonfiguration
# ------------------------------------------

# Webserver Einstellungen
PORT=5000
HOST=127.0.0.1

# Session Secret - Ändern Sie dies zu einem zufälligen String in der Produktion!
# Sie können einen sicheren Schlüssel mit Python generieren: 
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=your_secure_session_key_here

# ------------------------------------------
# API-Schlüssel für wissenschaftliche Datenbanken
# ------------------------------------------

# PubMed: Beantragen Sie einen API-Schlüssel bei https://www.ncbi.nlm.nih.gov/home/develop/api/
PUBMED_API_KEY=

# Deutsche Nationalbibliothek (DNB)
DNB_API_KEY=

# Scopus: Optional, beantragen bei https://dev.elsevier.com/
SCOPUS_API_KEY=

# Web of Science: Optional, beantragen bei https://clarivate.com/
WOS_API_KEY=

# ------------------------------------------
# Logging-Konfiguration
# ------------------------------------------
# Verfügbare Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_TO_FILE=TRUE
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ------------------------------------------
# Pfad-Einstellungen
# ------------------------------------------
# Ausgabeverzeichnis für gespeicherte Dateien
OUTPUT_PATH=./output

# Verzeichnis für Personenlisten
PERSON_LIST_PATH=./person_lists

# Verzeichnis für Backups
BACKUP_PATH=./backups

# ------------------------------------------
# Anwendungseinstellungen
# ------------------------------------------
# Standard-Datenbank für Suchen (PubMed, DNB, Scopus, WoS)
DEFAULT_DATABASE=PubMed

# Eindeutige Dateinamen für Exporte generieren (True/False)
UNIQUE_FILENAMES=True

# ------------------------------------------
# Email-Konfiguration (für Passwort-Reset)
# ------------------------------------------
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@example.com

# ------------------------------------------
# Entwicklungseinstellungen
# ------------------------------------------
# Auf True setzen, um Debug-Modus zu aktivieren (nur für Entwicklung!)
FLASK_DEBUG=False
FLASK_ENV=production  # 'development' oder 'production'

# Auf False setzen, um automatische Browser-Öffnung zu deaktivieren
OPEN_BROWSER=True

# Auf True setzen, um CSRF-Protection zu deaktivieren (nicht empfohlen!)
# CSRF_DISABLED=False